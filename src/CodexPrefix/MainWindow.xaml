<Window x:Class="CodexPrefix.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:CodexPrefix"
 Title="会话前缀" Icon="{StaticResource AppIcon}" Width="382" Height="188" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent" Topmost="True" FontFamily="Microsoft YaHei UI" FontSize="11" ShowActivated="False" WindowStartupLocation="CenterScreen">
  <local:SmoothBorder Background="{StaticResource BackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="14,10,14,10">
    <Grid x:Name="FullRootGrid"><Grid.RowDefinitions><RowDefinition Height="25"/><RowDefinition x:Name="EmojiActionRow" Height="48"/><RowDefinition Height="25"/><RowDefinition Height="36"/><RowDefinition Height="22"/></Grid.RowDefinitions>
      <Grid MouseLeftButtonDown="DragHeader" Background="Transparent"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Image x:Name="HeaderAppIcon" Source="{StaticResource AppIcon}" Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" ToolTip="会话前缀" AutomationProperties.Name="会话前缀应用图标"/>
        <Button x:Name="CompactToggle" Focusable="False" Grid.Column="1" Width="26" Height="24" Padding="0" Background="Transparent" BorderThickness="0" Click="ToggleCompact" AutomationProperties.Name="切换为跟随小条" ToolTip="切换为跟随小条">
          <Viewbox Width="17" Height="17"><Canvas Width="24" Height="24"><Path Data="{StaticResource CompactGeometry}" Stroke="#A3A3AE" StrokeThickness="2"/></Canvas></Viewbox>
        </Button>
        <CheckBox x:Name="PinToggle" Focusable="False" Style="{StaticResource DisabledPinStyle}" Grid.Column="2" Width="26" Height="24" IsChecked="True" VerticalAlignment="Center" Click="TogglePin" AutomationProperties.AutomationId="TopmostToggle" AutomationProperties.Name="切换工具置顶"/>
        <Button x:Name="CloseToolButton" Focusable="False" Grid.Column="3" Width="26" Height="24" Margin="4,0,0,0" Padding="0" Background="Transparent" BorderThickness="0" Click="CloseWindow" AutomationProperties.Name="关闭工具" AutomationProperties.AutomationId="CloseTool" ToolTip="关闭工具">
          <Viewbox Width="16" Height="16"><Canvas Width="24" Height="24"><Path Data="{StaticResource CloseGeometry}" Fill="#A3A3AE"/></Canvas></Viewbox>
        </Button>
      </Grid>
      <Grid Grid.Row="1" VerticalAlignment="Top" Margin="0,6.5,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="238"/><ColumnDefinition Width="1"/><ColumnDefinition Width="77"/></Grid.ColumnDefinitions>
        <Button x:Name="OpenRenameButton" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,2.5,0,0" Click="ClickOpenRename" Style="{StaticResource CompactActionButtonStyle}" AutomationProperties.Name="打开当前会话的重命名框" AutomationProperties.AutomationId="OpenRename" ToolTip="打开当前会话的重命名框">
          <Viewbox Width="16" Height="16" IsHitTestVisible="False"><Canvas Width="24" Height="24"><Path Data="{StaticResource EditGeometry}" Stroke="#A3A3AE" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Canvas></Viewbox>
        </Button>
        <local:EmojiViewport x:Name="FullEmojiViewport" Grid.Column="1" Width="230" Height="35" HorizontalAlignment="Left" VerticalAlignment="Top"><local:EmojiGridPanel x:Name="IconPanel"/></local:EmojiViewport>
        <Border Grid.Column="2" Height="24" Margin="0,5.5,0,0" VerticalAlignment="Top" Background="#393940"/>
        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Top" Margin="10,2.5,0,0">
          <Button x:Name="ClearButton" Style="{StaticResource CompactActionButtonStyle}" Focusable="True" Click="ClearPrefix" AutomationProperties.AutomationId="ClearPrefix" ToolTip="清除已登记的前缀"/>
          <Button x:Name="EmojiSettingsButton" Style="{StaticResource CompactActionButtonStyle}" Focusable="True" Margin="2,0,0,0" Click="ToggleEmojiSettings" AutomationProperties.AutomationId="EmojiSettings" ToolTip="编辑 emoji 列表"/>
        </StackPanel>
      </Grid>
      <TextBlock x:Name="TargetText" Grid.Row="2" Text="等待绑定原生重命名框" TextTrimming="CharacterEllipsis" Foreground="#B5B5C0" VerticalAlignment="Center"/>
      <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Border x:Name="StatusBorder" CornerRadius="7" BorderThickness="1" Margin="0,2,7,2" Padding="7,0" ClipToBounds="True">
          <Border.Background><SolidColorBrush Color="#1D2834"/></Border.Background>
          <Border.BorderBrush><SolidColorBrush Color="#385472"/></Border.BorderBrush>
          <Grid>
            <TextBlock x:Name="StatusText" Text="正在确认原生重命名框…" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite"><TextBlock.Foreground><SolidColorBrush Color="#ACD5FF"/></TextBlock.Foreground></TextBlock>
            <ProgressBar x:Name="StatusActivity" Height="2" VerticalAlignment="Bottom" Margin="0,0,0,2" IsIndeterminate="True" BorderThickness="0" Background="Transparent" Foreground="#73B7EF" IsHitTestVisible="False"/>
          </Grid>
        </Border>
        <Button x:Name="DiagnosticButton" Grid.Column="1" Content="诊断" Background="Transparent" BorderThickness="0" Padding="3,0" FontSize="10" Click="SaveDiagnostic" ToolTip="左键保存本地诊断；右键查看许可">
          <Button.ContextMenu><ContextMenu><MenuItem Header="第三方许可" Click="ShowLicenses"/></ContextMenu></Button.ContextMenu>
        </Button>
      </Grid>
      <Grid Grid.Row="4"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock x:Name="UpdateVersionText" Foreground="#888894" FontSize="10" VerticalAlignment="Center"/>
          <TextBlock x:Name="UpdateStateText" Foreground="#B5B5C0" Margin="5,0,0,0" FontSize="10" VerticalAlignment="Center" MaxWidth="180" TextTrimming="CharacterEllipsis"/>
          <Button x:Name="UpdateActionButton" Width="22" Height="20" Margin="4,0,0,0" Padding="0" Background="Transparent" BorderThickness="0" Focusable="False" Click="ClickUpdateAction" ToolTip="检查更新"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button x:Name="ProfileToggleButton" Width="24" Height="20" Padding="0" Background="Transparent" BorderThickness="0" Focusable="False" Click="ClickProfileToggle" ToolTip="切换个人列表与默认模板"/>
          <Button x:Name="SaveDefaultButton" Width="24" Height="20" Padding="0" Background="Transparent" BorderThickness="0" Visibility="Collapsed" Click="ClickSaveDefault" ToolTip="另存为本机默认模板"/>
        </StackPanel>
      </Grid>
      <Border x:Name="EmojiInputLayer" Panel.ZIndex="200" Visibility="Collapsed" Background="#FA202024" BorderBrush="#50505A" BorderThickness="1" CornerRadius="10" Padding="12" KeyboardNavigation.TabNavigation="Cycle">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <TextBlock x:Name="EmojiInputHeading" Text="添加一枚 emoji" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,8"/>
          <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
            <TextBox x:Name="EmojiInputText" Background="#141416" Foreground="White" BorderBrush="#686877" Padding="7" FontSize="16" TextChanged="EmojiInputChanged" AutomationProperties.Name="输入一枚完整 emoji" AutomationProperties.AutomationId="EmojiInput"/>
            <Image x:Name="EmojiInputPreview" Grid.Column="1" Width="28" Height="28"/>
          </Grid>
          <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="160" Margin="0,8,0,8" Focusable="False">
            <TextBlock x:Name="EmojiInputHint" TextWrapping="Wrap" FontSize="10" Foreground="#B7B8C2" MinHeight="48"/>
          </ScrollViewer>
          <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="EmojiInputCancel" Content="取消" Padding="10,5" Click="CancelEmojiInput" AutomationProperties.AutomationId="EmojiInputCancel"/>
            <Button x:Name="EmojiInputConfirm" Content="添加" Padding="10,5" Margin="8,0,0,0" Click="ConfirmEmojiInput" AutomationProperties.AutomationId="EmojiInputConfirm"/>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </local:SmoothBorder>
</Window>
